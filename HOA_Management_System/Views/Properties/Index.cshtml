@model IEnumerable<HOA_Management_System.Models.ViewModels.PropertyViewModel>

@{
    ViewData["Title"] = "Property Management";
}

<div class="card-box">

    <form method="get" asp-action="Index">
        <div class="search-container d-flex justify-content-between align-items-center mb-4">

            <div class="input-group" style="max-width: 500px;">
                <span class="input-group-text bg-white border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" name="searchString" class="form-control border-start-0"
                       placeholder="Search by Block & Lot or Homeowner Name..."
                       value="@ViewData["CurrentSearch"]">
                <button class="btn btn-outline-secondary" type="submit">Search</button>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="balanceSwitch" name="showWithBalance" value="true"
                       onchange="this.form.submit()"
                       @(ViewData["ShowBalance"] != null && (bool)ViewData["ShowBalance"] ? "checked" : "")>
                <label class="form-check-label text-muted small fw-bold" for="balanceSwitch">Show with Balance Only</label>
            </div>

        </div>
    </form>

    <div class="mt-2">
        <h6 class="mb-3 text-secondary">Property Listings</h6>

        <table class="table table-hover table-custom align-middle">
            <thead class="table-light">
                <tr>
                    <th>Block & Lot</th>
                    <th>Homeowner Name</th>
                    <th>Balance</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@item.BlockLot</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span>@item.HomeownerName</span>
                            </div>
                        </td>
                        <td>
                            @if (item.Balance > 0)
                            {
                                <span class="badge bg-danger">₱@item.Balance.ToString("N2")</span>
                            }
                            else if (item.Balance < 0)
                            {
                                <span class="badge bg-success">
                                    ₱@((item.Balance * -1).ToString("N2"))
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">₱0.00</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.PropertyId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                <i class="fa-regular fa-eye"></i> View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-folder-open fa-2x mb-3"></i>
                <p>No properties found matching your criteria.</p>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">
        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               asp-route-searchString="@ViewData["CurrentSearch"]"
               asp-route-showWithBalance="@ViewData["ShowBalance"]"
               class="btn btn-outline-success btn-sm">
                <i class="fa-solid fa-chevron-left"></i> Previous
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
        }

        <span class="text-muted small fw-bold">
            Page @ViewBag.CurrentPage of @ViewBag.TotalPages
        </span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage + 1)"
               asp-route-searchString="@ViewData["CurrentSearch"]"
               asp-route-showWithBalance="@ViewData["ShowBalance"]"
               class="btn btn-outline-success btn-sm">
                Next <i class="fa-solid fa-chevron-right"></i>
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" disabled>Next</button>
        }
    </div>
</div>