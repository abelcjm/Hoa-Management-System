@model HOA_Management_System.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrator Dashboard";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Administrator Dashboard</h4>
            <small class="text-secondary">Overview for @DateTime.Now.ToString("MMMM yyyy")</small>
        </div>
        <div class="bg-white px-3 py-2 rounded border text-secondary shadow-sm">
            <i class="fa-regular fa-calendar me-2"></i> @DateTime.Now.ToString("MMMM yyyy")
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Total Homeowners</small>
                        <h3 class="fw-bold text-dark mt-2 mb-0">@Model.TotalHomeowners</h3>
                        <small class="text-secondary">Active households</small>
                    </div>
                    <div class="bg-teal-light text-teal rounded p-3">
                        <i class="fa-solid fa-users fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Dues Collected</small>
                        <h3 class="fw-bold text-dark mt-2 mb-0">₱@Model.TotalCollectedThisMonth.ToString("N0")</h3>
                        <small class="text-success fw-bold">From this month's bills</small>
                    </div>
                    <div class="bg-teal-light text-teal rounded p-3">
                        <i class="fa-solid fa-peso-sign fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Outstanding Balance</small>
                        <h3 class="fw-bold text-danger mt-2 mb-0">₱@Model.TotalOutstandingBalance.ToString("N0")</h3>
                        <small class="text-secondary">Unpaid for this month</small>
                    </div>
                    <div class="bg-red-light text-red rounded p-3"><i class="fa-solid fa-exclamation-triangle fa-lg"></i></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Collection Efficiency</small>
                        <h3 class="fw-bold text-dark mt-2 mb-0">@Model.CollectionEfficiency.ToString("N0")%</h3>
                        @if (Model.EfficiencyChange >= 0)
                        {
                            <small class="text-success fw-bold">+@Model.EfficiencyChange.ToString("N1")%</small> <small class="text-secondary">Compliance</small>
                        }
                        else
                        {
                            <small class="text-danger fw-bold">-@Math.Abs(Model.EfficiencyChange).ToString("N1")%</small> <small class="text-secondary">Compliance</small>
                        }
                    </div>
                    <div class="bg-teal-light text-teal rounded p-3">
                        <i class="fa-solid fa-percent fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Collection Efficiency Trends</h6>
                    <small class="text-secondary">Shows how well each month's generated bills are paid.</small>
                </div>
                <div class="card-body">
                    <canvas id="trendsChart" height="120"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h6 class="mb-0 fw-bold">Payment Status Distribution</h6>
                        <i class="fa-solid fa-circle-info text-secondary" title="Shows compliance for this month's bills"></i>
                    </div>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <div style="width: 250px; height: 250px;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            @{
                string bannerClass = Model.HealthStatus == "Healthy" ? "bg-success-subtle border-success text-success-emphasis" :
                Model.HealthStatus == "Average" ? "bg-warning-subtle border-warning text-warning-emphasis" :
                "bg-danger-subtle border-danger text-danger-emphasis";
                string iconClass = Model.HealthStatus == "Healthy" ? "fa-check-circle" : "fa-circle-exclamation";
            }
            <div class="card shadow-sm border @bannerClass">
                <div class="card-body d-flex align-items-center py-3">
                    <i class="fa-regular @iconClass fa-2x me-3"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Financial Health: @Model.HealthStatus</h5>
                        <small>Collection efficiency at @Model.CollectionEfficiency.ToString("N0")%. Outstanding balance within acceptable range.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <h6 class="fw-bold text-dark mb-3">Quick Actions</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <a asp-controller="Properties" asp-action="Index" class="card shadow-sm border-0 text-decoration-none action-card">
                    <div class="card-body text-center py-4">
                        <i class="fa-solid fa-house fa-lg text-dark mb-2"></i>
                        <h6 class="fw-bold text-dark mb-0 small">View Properties</h6>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="AuditLogs" asp-action="Index" class="card shadow-sm border-0 text-decoration-none action-card">
                    <div class="card-body text-center py-4">
                        <i class="fa-solid fa-shield-halved fa-lg text-dark mb-2"></i>
                        <h6 class="fw-bold text-dark mb-0 small">View Audit Logs</h6>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Users" asp-action="Index" class="card shadow-sm border-0 text-decoration-none action-card">
                    <div class="card-body text-center py-4">
                        <i class="fa-solid fa-users-gear fa-lg text-dark mb-2"></i>
                        <h6 class="fw-bold text-dark mb-0 small">Manage Users</h6>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Backup" asp-action="Index" class="card shadow-sm border-0 text-decoration-none action-card">
                    <div class="card-body text-center py-4">
                        <i class="fa-solid fa-database fa-lg text-dark mb-2"></i>
                        <h6 class="fw-bold text-dark mb-0 small">Backup Data</h6>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0" style="background-color: #f8f9fa;">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3">Monthly Insights</h6>
                    <p class="text-secondary mb-0" style="line-height: 1.6;">
                        @Html.Raw(Model.InsightMessage)
                    </p>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .text-teal { color: #0f766e !important; }
    .bg-teal-light { background-color: #ccfbf1 !important; }
    .action-card:hover { background-color: #f8f9fa; transition: 0.2s; }
    .text-red { color: #dc2626 !important; }
    .bg-red-light { background-color: #fee2e2 !important; }
</style>

<script>
    const ctxTrends = document.getElementById('trendsChart').getContext('2d');
    new Chart(ctxTrends, {
        type: 'bar',
        data: {
            labels: @Json.Serialize(Model.TrendLabels),
            datasets: [
                { label: 'Paid Dues', data: @Json.Serialize(Model.TrendCollected), backgroundColor: '#0f766e', borderRadius: 4, barThickness: 15 },
                { label: 'Target', data: @Json.Serialize(Model.TrendTarget), backgroundColor: '#ccfbf1', borderRadius: 4, barThickness: 15 }
            ]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { display: true, grid: { borderDash: [2, 4] } },
                x: { grid: { display: false } }
            }
        }
    });

    const ctxStatus = document.getElementById('statusChart').getContext('2d');
    new Chart(ctxStatus, {
        type: 'pie',
        data: {
            labels: ['Paid', 'Partial', 'Unpaid'],
            datasets: [{
                data: [@Model.PiePaid, @Model.PiePartial, @Model.PieUnpaid],
                backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 8 } }
            }
        }
    });
</script>