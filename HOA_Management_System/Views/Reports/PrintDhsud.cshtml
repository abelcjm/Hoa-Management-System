@model IEnumerable<dynamic>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>DHSUD Master List</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        @@page {
            size: landscape;
            margin: 5mm;
        }

        body {
            padding: 15px;
            font-family: sans-serif;
            font-size: 9px;
        }
        /* Smaller font */
        .table th {
            background-color: #f8f9fa;
            vertical-align: middle;
            text-align: center;
            white-space: nowrap;
            font-size: 8px;
        }

        .table td {
            vertical-align: middle;
            white-space: nowrap;
        }

        h2 {
            font-size: 16px;
            margin-bottom: 2px;
        }

        .header-section {
            margin-bottom: 15px;
            border-bottom: 2px solid black;
            padding-bottom: 5px;
        }

        .bg-tenant {
            background-color: #f0fdf4;
        }
        /* Light green for tenant info */
        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="d-flex justify-content-between align-items-end header-section">
        <div>
            <h2>HOA Membership Master List</h2>
            <small class="text-muted">Generated on @DateTime.Now.ToString("MMMM dd, yyyy")</small>
        </div>
        <button onclick="window.print()" class="btn btn-sm btn-primary no-print">Save as PDF</button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped">
            <thead>
                <tr>
                    <th colspan="2">Property</th>
                    <th colspan="6">Primary Contact (Owner or Tenant Fallback)</th>
                    <th colspan="2" class="bg-tenant">Active Tenant</th>
                    <th colspan="5">Household</th>
                    <th colspan="3">Pets</th>
                </tr>
                <tr>
                    <th>Blk</th>
                    <th>Lot</th>
                    <th>Full Name</th>
                    <th>Status</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Civil</th>
                    <th>Voter?</th>

                    <th class="bg-tenant">Name</th>
                    <th class="bg-tenant">Contact</th>

                    <th>Seniors</th>
                    <th>Helpers</th>
                    <th>Kids</th>
                    <th>Others</th>
                    <th>Total</th>

                    <th>Dogs</th>
                    <th>Cats</th>
                    <th>Others</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Block</td>
                        <td class="fw-bold">@item.Lot</td>
                        <td>
                            <span class="fw-bold">@item.LastName</span>, @item.FirstName<br />
                        </td>
                        <td>@item.Status</td>
                        <td>@item.Contact</td>
                        <td>@item.Email</td>
                        <td>@item.CivilStatus</td>
                        <td class="text-center">@item.IsVoter</td>

                        <td class="bg-tenant">@item.TenantName</td>
                        <td class="bg-tenant">@item.TenantContact</td>

                        <td class="text-center">@item.Seniors</td>
                        <td class="text-center">@item.Helpers</td>
                        <td class="text-center">@item.Children</td>
                        <td class="text-center">@item.Others</td>
                        <td class="fw-bold text-center">@item.TotalMembers</td>

                        <td class="text-center">@item.Dogs</td>
                        <td class="text-center">@item.Cats</td>
                        <td>@item.OtherPets</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>