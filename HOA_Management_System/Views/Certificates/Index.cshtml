@using Microsoft.AspNetCore.Http
@model IEnumerable<HOA_Management_System.Models.Certification>

@{
    ViewData["Title"] = "Certificates";

    // --- SETUP SECURITY ROLE ---
    var userRole = Context.Session.GetString("Role");
    bool canEdit = userRole == "Admin" || userRole == "Encoder";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-success fw-bold">Certificates</h3>
    <div class="d-flex justify-content-between align-items-center mb-4">
        @if (canEdit)
        {
            <div>
                <a asp-controller="Payments" asp-action="Index" asp-route-preType="Certification" class="btn btn-success">
                    <i class="fa-solid fa-plus me-2"></i> Add Certificate
                </a>
            </div>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">Total Issued</small>
                <h2 class="fw-bold text-dark mt-2">@ViewBag.TotalIssuedYear</h2>
                <small class="text-muted">This year</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">This Month</small>
                <h2 class="fw-bold text-dark mt-2">@ViewBag.IssuedThisMonth</h2>
                <small class="text-muted">@DateTime.Now.ToString("MMMM yyyy")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">Total Revenue</small>
                <h2 class="fw-bold text-dark mt-2">₱@ViewBag.TotalRevenue.ToString("N0")</h2>
                <small class="text-muted">This Year (@DateTime.Now.Year)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <div class="card-body">
                <small class="text-muted text-uppercase fw-bold">Most Requested</small>
                <h4 class="fw-bold text-dark mt-2">@ViewBag.MostRequested</h4>
                <small class="text-muted">@ViewBag.MostRequestedCount issued</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <h5 class="card-title mb-3 text-secondary">Issued Certificates</h5>
        <table class="table table-hover align-middle">
            <thead class="bg-light">
                <tr>
                    <th class="text-muted small text-uppercase">Certificate Type</th>
                    <th class="text-muted small text-uppercase">Requestor</th>
                    <th class="text-muted small text-uppercase">Date Issued</th>
                    <th class="text-muted small text-uppercase">Fee</th>
                    <th class="text-muted small text-uppercase">Processed By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@item.CertType</td>
                        <td>@item.RequestorName</td>
                        <td>@item.DateIssued?.ToString("yyyy-MM-dd")</td>
                        <td class="fw-bold">₱@item.FeeAmount.ToString("N0")</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle border d-flex justify-content-center align-items-center me-2" style="width:30px;height:30px;">
                                    <i class="fa-solid fa-user small text-muted"></i>
                                </div>
                                <small>@item.IssuedByNavigation?.Username</small>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">No certificates found.</td></tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3">

            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-sm btn-outline-success">
                    <i class="fa-solid fa-chevron-left"></i> Previous
                </a>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
            }

            <span class="small text-muted fw-bold">
                Page @ViewBag.CurrentPage of @ViewBag.TotalPages
            </span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-sm btn-outline-success">
                    Next <i class="fa-solid fa-chevron-right"></i>
                </a>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" disabled>Next</button>
            }
        </div>

    </div>
</div>

<div class="modal fade" id="addCertModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Log Issued Certificate</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddCertificate" method="post">
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Block No.</label>
                            <input type="number" name="BlockNo" class="form-control" required placeholder="Ex. 12" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Lot No.</label>
                            <input type="number" name="LotNo" class="form-control" required placeholder="Ex. 5" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Requestor Name</label>
                        <input type="text" name="RequestorName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Certificate Type</label>
                        <select name="CertType" class="form-select">
                            <option value="Clearance">Clearance</option>
                            <option value="Good Moral">Good Moral</option>
                            <option value="Residency">Residency</option>
                            <option value="No Dues">No Dues</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Fee Amount</label>
                        <input type="number" step="0.01" name="FeeAmount" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Record</button>
                </div>
            </form>
        </div>
    </div>
</div>