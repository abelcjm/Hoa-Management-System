@model HOA_Management_System.Models.ViewModels.AnalyticsViewModel
@{
    ViewData["Title"] = "Financial Analytics";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-teal mb-0">Financial Analytics</h4>

        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2" id="filterForm">
            <select name="filterType" id="filterType" class="form-select form-select-sm border shadow-sm fw-bold text-secondary" style="width: auto;">
                <option value="Historical" selected="@(Model.FilterType == "Historical")">Historical (All Time)</option>
                <option value="Yearly" selected="@(Model.FilterType == "Yearly")">Yearly</option>
                <option value="Quarterly" selected="@(Model.FilterType == "Quarterly")">Quarterly</option>
                <option value="Monthly" selected="@(Model.FilterType == "Monthly")">Monthly</option>
            </select>

            <select name="year" id="yearSelect" class="form-select form-select-sm border shadow-sm fw-bold text-secondary" style="width: auto; @(Model.FilterType == "Historical" ? "display: none;" : "")">
                @foreach (var y in Model.AvailableYears)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                }
            </select>

            <select name="period" id="periodSelect" class="form-select form-select-sm border shadow-sm fw-bold text-secondary" style="width: auto; display: none;">
            </select>

            <button type="submit" class="btn btn-sm btn-teal text-white shadow-sm">Apply</button>
        </form>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Total Collected</small>
                        <h3 class="fw-bold text-dark mt-2 mb-0">₱@Model.TotalCollected.ToString("N0")</h3>
                        <small class="text-success fw-bold">Cash Flow in selected period</small>
                    </div>
                    <div class="bg-teal-light text-teal rounded p-3"><i class="fa-solid fa-peso-sign fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Outstanding Balance</small>
                        <h3 class="fw-bold text-danger mt-2 mb-0">₱@Model.TotalOutstanding.ToString("N0")</h3>
                        <small class="text-secondary">out of <span class="fw-bold text-dark">₱@Model.TotalExpectedDues.ToString("N0")</span> billed</small>
                    </div>
                    <div class="bg-red-light text-red rounded p-3"><i class="fa-solid fa-exclamation-triangle fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Billing Compliance</small>
                        <h3 class="fw-bold text-dark mt-2 mb-0">@Model.AverageEfficiency.ToString("N2")%</h3>
                        <small class="text-secondary">Current Live Status</small>
                    </div>
                    <div class="bg-teal-light text-teal rounded p-3"><i class="fa-solid fa-list-check fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-secondary">Delinquency Rate</small>
                        <h3 class="fw-bold text-dark mt-2 mb-0">@Model.AverageDelinquencyRate.ToString("N2")%</h3>
                        <small class="text-secondary">@(Model.FilterType == "Yearly" || Model.FilterType == "Historical" ? "Average" : "For selected period")</small>
                    </div>
                    <div class="bg-teal-light text-teal rounded p-3"><i class="fa-solid fa-arrow-trend-up fa-lg"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="fw-bold text-dark mb-0">Cash Flow Trend (@Model.FilterType)</h6>
                    <small class="text-secondary">Overall cash received (includes Dues, Stickers, Certificates, and Advanced Payments)</small>
                </div>
                <div class="card-body">
                    <canvas id="monthlyCollectionChart" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0">Projected vs Actual Cash (Cumulative)</h6>
                        <span class="badge bg-light text-secondary border">Forecast</span>
                    </div>
                    <small class="text-secondary d-block mt-1">
                        Performance of incoming cash against projected revenue target
                    </small>
                </div>
                <div class="card-body">
                    <canvas id="projectionChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    @if (Model.FilterType == "Historical")
    {
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="fw-bold text-dark mb-0">Delinquency Heatmap (By Block)</h6>
                            <i class="fa-solid fa-circle-info text-secondary" title="Shows all time risk areas"></i>
                        </div>
                        <small class="text-muted fst-italic" style="font-size: 0.75rem;">
                            Based on all-time historical debt performance.
                        </small>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table align-middle mb-0 table-hover">
                                <thead class="bg-light text-secondary sticky-top">
                                    <tr>
                                        <th class="ps-4">Block</th>
                                        <th>Delinquency Rate</th>
                                        <th>Delinquent (3+ Yrs)</th>
                                        <th>Total Debt</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var block in Model.BlockHeatmap.Take(5))
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">Block @block.Block</td>
                                            <td style="width: 35%;">
                                                <div class="d-flex align-items-center">
                                                    <span class="me-2 text-secondary small fw-bold">@block.DelinquencyRate.ToString("N0")%</span>
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar @(block.DelinquencyRate > 20 ? "bg-danger" : "bg-warning")" role="progressbar" style="width: @block.DelinquencyRate%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-secondary small">@block.DelinquentCount / @block.PropertyCount</td>
                                            <td class="fw-bold text-secondary">₱@block.TotalDebt.ToString("N0")</td>
                                            <td>
                                                @if (block.DelinquencyRate > 20)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">High Risk</span>
                                                }
                                                else if (block.DelinquencyRate > 10)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">Medium</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success">Low</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (!Model.BlockHeatmap.Any())
                                    {
                                        <tr><td colspan="5" class="text-center py-4 text-muted">No delinquency data available.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold text-dark mb-0">Top 5 Arrears</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var acc in Model.TopDelinquents)
                            {
                                <div class="list-group-item px-4 py-3 border-0 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.9rem;">@acc.Homeowner</h6>
                                        <span class="badge bg-danger rounded-pill">₱@acc.TotalDebt.ToString("N0")</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <small class="text-secondary d-block fw-bold">@acc.BlockLot</small>
                                            <small class="text-danger" style="font-size: 0.75rem;">@acc.MonthsOverdue months unpaid</small>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!Model.TopDelinquents.Any())
                            {
                                <div class="p-4 text-center text-muted">No accounts in arrears.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="fw-bold text-dark mb-0">Billed Dues Compliance</h6>
                        </div>
                        <small class="text-muted fst-italic" style="font-size: 0.75rem;">Current live status of all bills generated historically.</small>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <div style="width: 220px; height: 220px;">
                            <canvas id="segmentationChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 text-center pb-4">
                        <small class="text-secondary fw-bold">Total Bills Evaluated: @(Model.CountPaid + Model.CountPartial + Model.CountUnpaid)</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold text-dark mb-0">Income Source Distribution</h6>
                        <small class="text-muted fst-italic" style="font-size: 0.75rem;">Includes regular, late, and advanced dues.</small>
                    </div>
                    <div class="card-body d-flex justify-content-center">
                        <div style="width: 240px; height: 240px;">
                            <canvas id="distributionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="fw-bold text-dark mb-0">Billed Dues Compliance</h6>
                        </div>
                        <small class="text-muted fst-italic" style="font-size: 0.75rem;">Current live status of bills generated in the <strong>@Model.FilterType</strong> period.</small>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <div style="width: 220px; height: 220px;">
                            <canvas id="segmentationChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 text-center pb-4">
                        <small class="text-secondary fw-bold">Total Bills Evaluated: @(Model.CountPaid + Model.CountPartial + Model.CountUnpaid)</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold text-dark mb-0">Income Source Distribution</h6>
                        <small class="text-muted fst-italic" style="font-size: 0.75rem;">Includes regular, late, and advanced dues.</small>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <div style="width: 240px; height: 240px;">
                            <canvas id="distributionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <div class="d-flex justify-content-between align-items-start">
                        <h6 class="fw-bold text-dark mb-0">Historical Compliance</h6>
                        <i class="fa-solid fa-circle-info text-secondary" title="Shows on-time payment behavior at the time the month ended."></i>
                    </div>
                    <small class="text-secondary d-block mt-1">Shows the locked-in percentage of bills paid on time at the end of each past month.</small>
                </div>
                <div class="card-body">
                    <canvas id="snapshotChart" height="150"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="fw-bold text-dark mb-0">Delinquency Rate History</h6>
                    <small class="text-secondary d-block mt-1">Tracks the percentage of households that have accumulated 36 or more unpaid monthly bills.</small>
                </div>
                <div class="card-body">
                    <canvas id="delinquencyChart" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 bg-light shadow-sm">
        <div class="card-body p-4">
            <h6 class="fw-bold text-dark mb-3">Analytics Insights</h6>
            <ul class="list-unstyled mb-0 text-secondary" style="line-height: 1.8;">
                @foreach (var insight in Model.GeneratedInsights)
                {
                    <li class="mb-3"><i class="fa-solid fa-circle-info text-teal me-2"></i> @Html.Raw(insight)</li>
                }
            </ul>
        </div>
    </div>
</div>

<style>
    .text-teal {
        color: #0f766e !important;
    }

    .bg-teal-light {
        background-color: #ccfbf1 !important;
    }

    .btn-teal {
        background-color: #0f766e !important;
        border-color: #0f766e !important;
    }

        .btn-teal:hover {
            background-color: #115e59 !important;
        }

    .text-red {
        color: #dc2626 !important;
    }

    .bg-red-light {
        background-color: #fee2e2 !important;
    }

    .table-responsive::-webkit-scrollbar {
        width: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 3px;
    }
</style>

<script>
    // === DYNAMIC FILTER LOGIC ===
    const filterType = document.getElementById('filterType');
    const yearSelect = document.getElementById('yearSelect');
    const periodSelect = document.getElementById('periodSelect');
    const selectedPeriod = @(Model.SelectedPeriod ?? 0);

    function updatePeriodOptions() {
        const type = filterType.value;
        periodSelect.innerHTML = "";

        if (type === "Historical") {
            yearSelect.style.display = "none";
            periodSelect.style.display = "none";
        } else if (type === "Yearly") {
            yearSelect.style.display = "block";
            periodSelect.style.display = "none";
        } else {
            yearSelect.style.display = "block";
            periodSelect.style.display = "block";

            if (type === "Quarterly") {
                const quarters = ["Q1 (Jan-Mar)", "Q2 (Apr-Jun)", "Q3 (Jul-Sep)", "Q4 (Oct-Dec)"];
                quarters.forEach((q, index) => {
                    let opt = new Option(q, index + 1);
                    if (index + 1 === selectedPeriod) opt.selected = true;
                    periodSelect.add(opt);
                });
            } else if (type === "Monthly") {
                const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                months.forEach((m, index) => {
                    let opt = new Option(m, index + 1);
                    if (index + 1 === selectedPeriod) opt.selected = true;
                    periodSelect.add(opt);
                });
            }
        }
    }
    updatePeriodOptions();
    filterType.addEventListener('change', updatePeriodOptions);

    // === HIGHLIGHT MAPPING FOR LINE CHARTS ===
    const barColors = @Json.Serialize(Model.BarColors);

    // Makes the highlighted period a large radius (6) and others small (3)
    const lineRadii = barColors.map(c => c === '#0f766e' ? 6 : 3);

    // Adjusts the point colors to match their respective chart themes
    const snapPointColors = barColors.map(c => c === '#0f766e' ? '#10b981' : '#e2e8f0');
    const delinqPointColors = barColors.map(c => c === '#0f766e' ? '#ef4444' : '#e2e8f0');
    const projPointColors = barColors.map(c => c === '#0f766e' ? '#0f766e' : '#e2e8f0');

    // === CHART 1: CASH FLOW TREND ===
    new Chart(document.getElementById('monthlyCollectionChart').getContext('2d'), {
        type: 'bar',
        data: {
            labels: @Json.Serialize(Model.ChartLabels),
            datasets: [
                {
                    label: 'Collected (Cash)',
                    data: @Json.Serialize(Model.CollectionData),
                    backgroundColor: barColors,
                    order: 2
                },
                @if (Model.FilterType != "Monthly")
                {
                        <text>
                        {
                            label: 'Target',
                            data: @Json.Serialize(Model.TargetData),
                            type: 'line',
                            borderColor: '#f59e0b',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            pointRadius: 0,
                            order: 1
                        }
                        </text>
                }
            ]
        },
        options: { responsive: true, scales: { y: { beginAtZero: true }, x: { grid: { display: false } } } }
    });

    // === CHART 2: HISTORICAL COMPLIANCE ===
    new Chart(document.getElementById('snapshotChart').getContext('2d'), {
        type: 'line',
        data: {
            labels: @Json.Serialize(Model.SnapshotLabels),
            datasets: [{
                label: 'On-Time Compliance',
                data: @Json.Serialize(Model.SnapshotData),
                borderColor: '#10b981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                pointBackgroundColor: snapPointColors,
                pointRadius: lineRadii,
                borderWidth: 2,
                tension: 0.3,
                fill: true
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true, suggestedMax: 100 } },
            plugins: {
                tooltip: { callbacks: { label: function(context) { return context.dataset.label + ': ' + context.parsed.y.toFixed(2) + '%'; } } }
            }
        }
    });

    // === CHART 3: DELINQUENCY TREND ===
    new Chart(document.getElementById('delinquencyChart').getContext('2d'), {
        type: 'line',
        data: {
            labels: @Json.Serialize(Model.ChartLabels),
            datasets: [{
                label: 'Delinquency Rate',
                data: @Json.Serialize(Model.DelinquencyData),
                borderColor: '#ef4444',
                backgroundColor: 'rgba(239, 68, 68, 0.1)',
                pointBackgroundColor: delinqPointColors,
                pointRadius: lineRadii,
                borderWidth: 2,
                tension: 0.1,
                fill: true
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true, suggestedMax: 10 } },
            plugins: {
                tooltip: { callbacks: { label: function(context) { return context.dataset.label + ': ' + context.parsed.y.toFixed(2) + '%'; } } }
            }
        }
    });

    // === CHART 4: INCOME SOURCE DISTRIBUTION ===
    new Chart(document.getElementById('distributionChart').getContext('2d'), {
        type: 'pie',
        data: {
            labels: ['Monthly Dues', 'Certificates', 'Stickers'],
            datasets: [{ data: [@Model.AmountDues, @Model.AmountCertificates, @Model.AmountStickers], backgroundColor: ['#0f766e', '#f59e0b', '#64748b'], borderWidth: 0 }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });

    // === CHART 5: PROJECTED VS ACTUAL ===
    new Chart(document.getElementById('projectionChart').getContext('2d'), {
        type: 'line',
        data: {
            labels: @Json.Serialize(Model.ChartLabels),
            datasets: [
                {
                    label: 'Actual Cash Cumulative',
                    data: @Json.Serialize(Model.CumulativeActual),
                    borderColor: '#0f766e',
                    backgroundColor: '#0f766e',
                    pointBackgroundColor: projPointColors,
                    pointRadius: lineRadii,
                    borderWidth: 3,
                    tension: 0.1,
                    fill: false
                },
                {
                    label: 'Projected',
                    data: @Json.Serialize(Model.CumulativeProjected),
                    borderColor: '#94a3b8',
                    borderWidth: 2,
                    borderDash: [5, 5],
                    pointRadius: 0,
                    tension: 0.1
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { position: 'top' } },
            scales: { y: { beginAtZero: true } }
        }
    });

    // === CHART 6: PAYMENT STATUS DISTRIBUTION ===
    new Chart(document.getElementById('segmentationChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Fully Paid', 'Arrears', 'Unpaid'],
            datasets: [{
                data: [@Model.CountPaid, @Model.CountPartial, @Model.CountUnpaid],
                backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } },
            cutout: '65%'
        }
    });
</script>